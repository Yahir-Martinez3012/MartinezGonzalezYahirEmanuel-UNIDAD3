# Variables de entorno de Conecta UTC.
# En local los valores por defecto de settings.py ya funcionan; esto documenta lo que se configura en producción.
# Nunca subas valores reales al repositorio.
SECRET_KEY=genera-una-clave-larga-y-aleatoria
DEBUG=False
# Base de datos persistente (PostgreSQL). Sin esta variable se usa SQLite local.
DATABASE_URL=postgres://usuario:contrasena@host:5432/basededatos?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_PASSWORD=define-una-contrasena-para-las-cuentas-demo
# reCAPTCHA v2 (https://www.google.com/recaptcha/admin). Sin claves, el formulario funciona sin captcha.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Resend (https://resend.com): correos de cambio de estado. Sin clave no se envían correos.
RESEND_API_KEY=
CORREO_REMITENTE=Conecta UTC <onboarding@resend.dev>
